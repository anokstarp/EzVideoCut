<Window x:Class="EzVideoCut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EZ Video Cut"
        MinHeight="720"
        MinWidth="1040"
        Height="820"
        Width="1440"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#FCFCFB"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
        FontSize="13"
        Focusable="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="#20201D" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E7E6E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#F6F6F4" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#DDDDD8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#EFEFED" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#D7D7D1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#B5B4AF" />
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#F5F5F2" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#ECEBE7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#20201D" />
            <Setter Property="BorderBrush" Value="#20201D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#2D2D29" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#2D2D29" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#11110F" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#11110F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#9A9992" />
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#F1F1ED" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#E1E0DA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SelectedAudioTrackButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#0B73D9" />
            <Setter Property="BorderBrush" Value="#0B73D9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#0968C7" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#0968C7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#075DB2" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#075DB2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#20201D" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E7E6E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#20201D" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBoxChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="#BDBDB8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#B5B4AF" />
                                <Setter TargetName="TextBoxChrome" Property="Background" Value="#F5F5F2" />
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="#ECEBE7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#20201D" />
        </Style>
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E7E6E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="#20201D" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemChrome"
                                Background="Transparent"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#F5F5F2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#ECEFEB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#B5B4AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="#20201D" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E7E6E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0,24,0" />
            <Setter Property="MaxDropDownHeight" Value="220" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="ComboBoxChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center" />
                                    <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="#74716B"
                                          HorizontalAlignment="Right"
                                          Height="4"
                                          Margin="0,0,10,0"
                                          Stretch="Fill"
                                          VerticalAlignment="Center"
                                          Width="8" />
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="#FFFFFF"
                                        BorderBrush="#E7E6E2"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Padding="4"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBoxChrome" Property="Background" Value="#F6F6F4" />
                                <Setter TargetName="ComboBoxChrome" Property="BorderBrush" Value="#DDDDD8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBoxChrome" Property="BorderBrush" Value="#BDBDB8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#B5B4AF" />
                                <Setter TargetName="ComboBoxChrome" Property="Background" Value="#F5F5F2" />
                                <Setter TargetName="ComboBoxChrome" Property="BorderBrush" Value="#ECEBE7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#20201D" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemChrome"
                                Background="Transparent"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#F5F5F2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#ECEFEB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#B5B4AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ProgressBar}">
            <Setter Property="Background" Value="#F0F0ED" />
            <Setter Property="Foreground" Value="#20201D" />
            <Setter Property="BorderBrush" Value="#E7E6E2" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="SliderTrackButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Height="{TemplateBinding Height}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbChrome"
                                Background="#FFFFFF"
                                BorderBrush="#D8D7D2"
                                BorderThickness="1"
                                CornerRadius="7"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#BDBDB8" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#F6F6F4" />
                                <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#AFAFA9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="22" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Height="{TemplateBinding Height}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="#20201D"
                                                  Style="{StaticResource SliderTrackButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="#E9E8E4"
                                                  Style="{StaticResource SliderTrackButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#55534E" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#F1F1EE" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Foreground" Value="#20201D" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#E9ECE8" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Foreground" Value="#20201D" />
                                <Setter Property="Panel.ZIndex" Value="10" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#9A9992" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeNavigationTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarLineButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbChrome"
                                Background="#D8DAD7"
                                CornerRadius="4"
                                Margin="2"
                                Opacity="0.75"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#C4C7C4" />
                                <Setter TargetName="ThumbChrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#ADB1AD" />
                                <Setter TargetName="ThumbChrome" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="MinHeight" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="VerticalTrack"
                                   IsDirectionReversed="True"
                                   Maximum="{TemplateBinding Maximum}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Orientation="Vertical"
                                   Value="{Binding Value, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource ScrollBarLineButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource ScrollBarLineButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                            <Track x:Name="HorizontalTrack"
                                   IsDirectionReversed="False"
                                   Maximum="{TemplateBinding Maximum}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Orientation="Horizontal"
                                   Value="{Binding Value, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Visibility="Collapsed">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                                  Style="{StaticResource ScrollBarLineButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                                  Style="{StaticResource ScrollBarLineButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="8" />
                                <Setter Property="MinHeight" Value="8" />
                                <Setter Property="Width" Value="Auto" />
                                <Setter TargetName="VerticalTrack" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="HorizontalTrack" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid Margin="0,0,16,16"
              Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Grid.RowSpan="5"
                Width="236"
                HorizontalAlignment="Left"
                Background="#F7F9FA"
                BorderBrush="#F7F9FA"
                BorderThickness="0" />

        <DockPanel Grid.Row="0" Margin="0,0,0,12" Visibility="Collapsed">
            <Button x:Name="OpenButton"
                    DockPanel.Dock="Left"
                    Click="OpenButton_Click"
                    Content="선택"
                    MinWidth="86"
                    Visibility="Collapsed" />
            <TextBlock x:Name="FileNameText"
                       Text="선택된 비디오 없음"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="14,0,0,0"
                       FontWeight="Medium" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,14,0"
                    Padding="12,10,10,10"
                    Background="#F7F9FA"
                    BorderBrush="#F7F9FA"
                    BorderThickness="0"
                    CornerRadius="0">
                <StackPanel>
                    <TextBlock Text="작업"
                               Margin="10,4,0,8"
                               Foreground="#8A8E92"
                               FontSize="12" />
                    <TabControl x:Name="CutModeTabs"
                                Style="{StaticResource ModeNavigationTabControlStyle}"
                                SelectedIndex="0"
                                SelectionChanged="CutModeTabs_SelectionChanged"
                                Background="Transparent">
                        <TabItem Header="지점 분할" />
                        <TabItem Header="범위 자르기" />
                        <TabItem Header="오디오 추출" />
                        <TabItem Header="이어 붙이기" />
                    </TabControl>
                </StackPanel>
            </Border>

            <Border x:Name="VideoHost"
                    Grid.Column="1"
                    Background="#0F0F0E"
                    BorderBrush="#E4E3DF"
                    BorderThickness="1"
                    CornerRadius="0"
                    SizeChanged="VideoHost_SizeChanged"
                    PreviewMouseDown="VideoHost_PreviewMouseDown">
                <Grid>
                    <Border x:Name="VideoSurface"
                            Background="#0F0F0E"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Grid>
                            <vlc:VideoView x:Name="VideoView"
                                           Visibility="Collapsed" />
                            <TextBlock x:Name="EmptyVideoText"
                                       Text="비디오를 선택하면 이곳에서 재생됩니다"
                                       Foreground="#D4DAE3"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </Grid>
        <Grid Grid.Row="1"
              Grid.RowSpan="4"
              Width="326"
              HorizontalAlignment="Right">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TabControl x:Name="LegacyCutModeTabs"
                            Visibility="Collapsed"
                            SelectedIndex="0"
                            SelectionChanged="CutModeTabs_SelectionChanged"
                            Margin="0,-27,0,0"
                            Background="Transparent"
                            Panel.ZIndex="1"
                            VerticalAlignment="Top">
                    <TabItem Header="지점 분할" />
                    <TabItem Header="범위 자르기" />
                    <TabItem Header="오디오 추출" />
                    <TabItem Header="이어 붙이기" />
                </TabControl>

                <Border Grid.Row="0"
                        Grid.RowSpan="2"
                        Panel.ZIndex="0"
                        Padding="16"
                        Background="#FFFFFF"
                        BorderBrush="#EDECE8"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14"
                                          ShadowDepth="1"
                                          Opacity="0.018"
                                          Color="#000000" />
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  Focusable="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1"
                          x:Name="RangeStartGrid"
                          Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="2"
                                   Text="시작·종료 지점을 지정해 설정한 구간을 잘라냅니다."
                                   Foreground="#5F6673"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Visibility="Collapsed" />
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="시작" FontWeight="Medium" />
                            <TextBox x:Name="StartTextBox"
                                     Text="00:00:00.000"
                                     Height="36"
                                     MinHeight="36"
                                     Padding="8,0"
                                     MaxLength="12"
                                     LostFocus="TimeTextBox_LostFocus"
                                     KeyDown="TimeTextBox_KeyDown"
                                     PreviewTextInput="TimeTextBox_PreviewTextInput"
                                     GotKeyboardFocus="TimeTextBox_GotKeyboardFocus"
                                     PreviewMouseDown="TimeTextBox_PreviewMouseDown"
                                     Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Grid.Row="1"
                                Grid.Column="1"
                                x:Name="SetStartButton"
                                Content="현재 위치"
                                Click="SetStartButton_Click"
                                Margin="10,22,0,0"
                                VerticalAlignment="Top"
                                IsEnabled="False" />
                    </Grid>

                    <Grid Grid.Row="1"
                          x:Name="SplitPointGrid"
                          Margin="0,14,0,0"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="2"
                                   Text="선택한 지점을 기준으로 앞뒤로 영상을 2개로 분할합니다."
                                   Foreground="#5F6673"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Visibility="Collapsed" />
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="분할 지점" FontWeight="Medium" />
                            <TextBox x:Name="SplitTextBox"
                                     Text="00:00:00.000"
                                     Height="36"
                                     MinHeight="36"
                                     Padding="8,0"
                                     MaxLength="12"
                                     LostFocus="TimeTextBox_LostFocus"
                                     KeyDown="TimeTextBox_KeyDown"
                                     PreviewTextInput="TimeTextBox_PreviewTextInput"
                                     GotKeyboardFocus="TimeTextBox_GotKeyboardFocus"
                                     PreviewMouseDown="TimeTextBox_PreviewMouseDown"
                                     Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Grid.Row="1"
                                Grid.Column="1"
                                x:Name="SetSplitButton"
                                Content="현재 위치"
                                Click="SetSplitButton_Click"
                                Margin="10,22,0,0"
                                VerticalAlignment="Top"
                                IsEnabled="False" />
                    </Grid>

                    <Grid Grid.Row="2"
                          x:Name="RangeEndGrid"
                          Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="종료" FontWeight="Medium" />
                            <TextBox x:Name="EndTextBox"
                                     Text="00:00:00.000"
                                     Height="36"
                                     MinHeight="36"
                                     Padding="8,0"
                                     MaxLength="12"
                                     LostFocus="TimeTextBox_LostFocus"
                                     KeyDown="TimeTextBox_KeyDown"
                                     PreviewTextInput="TimeTextBox_PreviewTextInput"
                                     GotKeyboardFocus="TimeTextBox_GotKeyboardFocus"
                                     PreviewMouseDown="TimeTextBox_PreviewMouseDown"
                                     Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="SetEndButton"
                                Content="현재 위치"
                                Click="SetEndButton_Click"
                                Margin="10,22,0,0"
                                IsEnabled="False" />
                    </Grid>

                    <Grid Grid.Row="0"
                          x:Name="ConcatOptionsGrid"
                          Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="VideoListDescriptionText"
                                   Text="2개 이상의 영상을 선택한 순서대로 이어 붙입니다."
                                   Foreground="#5F6673"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <Grid Grid.Row="1"
                              Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AddConcatVideosButton"
                                    Content="영상 추가"
                                    Click="AddConcatVideosButton_Click" />
                            <Button Grid.Column="2"
                                    x:Name="RemoveConcatVideoButton"
                                    Content="영상 제거"
                                    Click="RemoveConcatVideoButton_Click"
                                    IsEnabled="False" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox x:Name="ConcatClipsListBox"
                                     Height="118"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="ConcatClipsListBox_SelectionChanged" />
                            <Grid Grid.Row="1"
                                  x:Name="ConcatMoveButtonsGrid"
                                  Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="MoveConcatVideoUpButton"
                                        Content="위로"
                                        Click="MoveConcatVideoUpButton_Click"
                                        IsEnabled="False" />
                                <Button Grid.Column="2"
                                        x:Name="MoveConcatVideoDownButton"
                                        Content="아래로"
                                        Click="MoveConcatVideoDownButton_Click"
                                        IsEnabled="False" />
                            </Grid>
                            <Grid Grid.Row="2"
                                  Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ClearConcatVideosButton"
                                        Content="전체 비우기"
                                        Click="ClearConcatVideosButton_Click"
                                        IsEnabled="False" />
                                <Grid Grid.Column="2">
                                    <Button x:Name="SelectListedVideoButton"
                                            Content="영상 선택"
                                            Click="SelectListedVideoButton_Click"
                                            IsEnabled="False" />
                                    <TextBlock x:Name="ConcatTotalDurationText"
                                               Text="총 00:00:00.000"
                                               Foreground="#6B7280"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,18,0,0">
                        <TextBlock Text="출력 파일" FontWeight="Medium" />
                        <Border Margin="0,6,0,0"
                                MinHeight="32"
                                Padding="8,5"
                                BorderBrush="#EDECE8"
                                BorderThickness="1"
                                Background="#FAFAF8"
                                CornerRadius="7">
                            <TextBlock x:Name="OutputPathTextBlock"
                                       Text=""
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PickOutputButton"
                                    Content="저장 위치 선택"
                                    Click="PickOutputButton_Click"
                                    IsEnabled="False" />
                            <Button Grid.Column="2"
                                    x:Name="OpenOutputFolderButton"
                                    Content="폴더 열기"
                                    Click="OpenOutputFolderButton_Click"
                                    IsEnabled="False" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Margin="0,0,0,8">
                        <TextBlock x:Name="CutProgressText"
                                   Text=""
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap"
                                   MinHeight="22" />
                        <ProgressBar x:Name="CutProgressBar"
                                     Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Margin="0,6,0,0" />
                    </StackPanel>

                    <Button Grid.Row="6"
                            x:Name="CutButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="자르기 실행"
                            Click="CutButton_Click"
                            Height="42"
                            FontWeight="Medium"
                            IsEnabled="False" />
                </Grid>
                    </ScrollViewer>
                </Border>
                </Grid>
            </Grid>

        <Grid Grid.Row="2" Margin="236,14,354,0">
            <Border Background="#FFFFFF" BorderBrush="#EDECE8" BorderThickness="1" Padding="12" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10"
                                      ShadowDepth="1"
                                      Opacity="0.016"
                                      Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PlayPauseButton"
                            Content="재생"
                            Click="PlayPauseButton_Click"
                            Width="88"
                            IsEnabled="False" />
                    <TextBlock Grid.Column="1"
                               Text="이동간격"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0" />
                    <ComboBox Grid.Column="2"
                              x:Name="SeekStepComboBox"
                              Width="86"
                              SelectedIndex="2"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              IsEnabled="False">
                        <ComboBoxItem Content="1초" Tag="1" />
                        <ComboBoxItem Content="3초" Tag="3" />
                        <ComboBoxItem Content="5초" Tag="5" />
                        <ComboBoxItem Content="10초" Tag="10" />
                        <ComboBoxItem Content="30초" Tag="30" />
                        <ComboBoxItem Content="1분" Tag="60" />
                        <ComboBoxItem Content="3분" Tag="180" />
                        <ComboBoxItem Content="5분" Tag="300" />
                    </ComboBox>
                    <TextBlock Grid.Column="3"
                               Text="음량"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0" />
                    <Slider Grid.Column="4"
                            x:Name="VolumeSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="100"
                            PreviewMouseDown="VolumeSlider_PreviewMouseDown"
                            PreviewMouseMove="VolumeSlider_PreviewMouseMove"
                            PreviewMouseUp="VolumeSlider_PreviewMouseUp"
                            Width="100"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            IsEnabled="False" />
                    <TextBlock Grid.Column="5"
                               x:Name="VolumeValueText"
                               Text="100%"
                               Width="38"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Margin="6,0,0,0" />
                    <TextBlock Grid.Column="6"
                               x:Name="CurrentTimeText"
                               Text="00:00:00.000"
                               Width="92"
                               FontFamily="Consolas"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0" />
                    <Grid Grid.Column="7"
                          Margin="12,0"
                          VerticalAlignment="Center">
                        <Slider x:Name="TimelineSlider"
                                Minimum="0"
                                Maximum="1"
                                ValueChanged="TimelineSlider_ValueChanged"
                                PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                                PreviewMouseMove="TimelineSlider_PreviewMouseMove"
                                PreviewMouseUp="TimelineSlider_PreviewMouseUp"
                                IsEnabled="False"
                                VerticalAlignment="Center" />
                        <Canvas x:Name="TimelineMarkerCanvas"
                                Height="28"
                                VerticalAlignment="Center"
                                IsHitTestVisible="True"
                                SizeChanged="TimelineMarkerCanvas_SizeChanged" />
                    </Grid>
                    <TextBlock Grid.Column="8"
                               x:Name="DurationText"
                               Text="00:00:00.000"
                               Width="92"
                               FontFamily="Consolas"
                               TextAlignment="Left"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                x:Name="AudioTrackHost"
                Margin="236,10,354,0"
                Padding="12"
                Background="#FFFFFF"
                BorderBrush="#EDECE8"
                BorderThickness="1"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="1"
                                  Opacity="0.016"
                                  Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="오디오 트랙"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="AudioTrackHelpText"
                               DockPanel.Dock="Right"
                               Text="미리듣기에만 적용"
                               Foreground="#6B7280"
                               VerticalAlignment="Center" />
                </DockPanel>
                <CheckBox Grid.Row="1"
                          x:Name="MixAudioTracksCheckBox"
                          Content="오디오 트랙 1개로 믹싱"
                          Margin="0,8,0,0"
                          VerticalAlignment="Center"
                          Checked="MixAudioTracksCheckBox_Changed"
                          Unchecked="MixAudioTracksCheckBox_Changed"
                          ToolTip="제거하지 않은 오디오 트랙들을 하나의 AAC 오디오 트랙으로 합칩니다." />
                <ScrollViewer Grid.Row="2"
                              Margin="0,8,0,0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="AudioTracksPanel"
                                Orientation="Horizontal" />
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   Text="준비됨"
                   Foreground="#4B5563"
                   Margin="236,8,354,0" />
        </Grid>
    </Grid>
</Window>
