<Window x:Class="EzVideoCut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EZ Video Cut"
        MinHeight="720"
        MinWidth="1040"
        Height="820"
        Width="1180"
        Background="#F6F7F9"
        Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#20242A" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button x:Name="OpenButton"
                    DockPanel.Dock="Left"
                    Click="OpenButton_Click"
                    Content="선택"
                    MinWidth="86" />
            <TextBlock x:Name="FileNameText"
                       Text="선택된 비디오 없음"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="14,0,0,0"
                       FontWeight="SemiBold" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border x:Name="VideoHost"
                    Grid.Column="0"
                    Background="#101317"
                    BorderBrush="#D9DEE7"
                    BorderThickness="1"
                    PreviewMouseDown="VideoHost_PreviewMouseDown">
                <Grid>
                    <vlc:VideoView x:Name="VideoView" />
                    <TextBlock x:Name="EmptyVideoText"
                               Text="비디오를 선택하면 이곳에서 재생됩니다"
                               Foreground="#D4DAE3"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="14,0,0,0"
                    Padding="16"
                    Background="#FFFFFF"
                    BorderBrush="#D9DEE7"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="구간 설정" FontSize="20" FontWeight="SemiBold" />

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="시작" FontWeight="SemiBold" />
                            <TextBox x:Name="StartTextBox"
                                     Text="00:00:00.000"
                                     MaxLength="9"
                                     LostFocus="TimeTextBox_LostFocus"
                                     KeyDown="TimeTextBox_KeyDown"
                                     PreviewTextInput="TimeTextBox_PreviewTextInput"
                                     GotKeyboardFocus="TimeTextBox_GotKeyboardFocus"
                                     PreviewMouseDown="TimeTextBox_PreviewMouseDown"
                                     Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="SetStartButton"
                                Content="현재 위치"
                                Click="SetStartButton_Click"
                                Margin="10,22,0,0"
                                IsEnabled="False" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="종료" FontWeight="SemiBold" />
                            <TextBox x:Name="EndTextBox"
                                     Text="00:00:00.000"
                                     MaxLength="9"
                                     LostFocus="TimeTextBox_LostFocus"
                                     KeyDown="TimeTextBox_KeyDown"
                                     PreviewTextInput="TimeTextBox_PreviewTextInput"
                                     GotKeyboardFocus="TimeTextBox_GotKeyboardFocus"
                                     PreviewMouseDown="TimeTextBox_PreviewMouseDown"
                                     Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="SetEndButton"
                                Content="현재 위치"
                                Click="SetEndButton_Click"
                                Margin="10,22,0,0"
                                IsEnabled="False" />
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,18,0,0">
                        <TextBlock Text="출력 파일" FontWeight="SemiBold" />
                        <Border Margin="0,6,0,0"
                                Height="32"
                                Padding="8,5"
                                BorderBrush="#ABADB3"
                                BorderThickness="1"
                                Background="#F7F8FA">
                            <TextBlock x:Name="OutputPathTextBlock"
                                       Text=""
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PickOutputButton"
                                    Content="저장 위치 선택"
                                    Click="PickOutputButton_Click"
                                    IsEnabled="False" />
                            <Button Grid.Column="2"
                                    x:Name="OpenOutputFolderButton"
                                    Content="폴더 열기"
                                    Click="OpenOutputFolderButton_Click"
                                    IsEnabled="False" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,0,0,8">
                        <TextBlock x:Name="CutProgressText"
                                   Text=""
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap"
                                   MinHeight="22" />
                        <ProgressBar x:Name="CutProgressBar"
                                     Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Margin="0,6,0,0" />
                    </StackPanel>

                    <Button Grid.Row="5"
                            x:Name="CutButton"
                            Content="자르기 실행"
                            Click="CutButton_Click"
                            Height="42"
                            FontWeight="SemiBold"
                            IsEnabled="False" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,354,0">
            <Border Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PlayPauseButton"
                            Content="재생"
                            Click="PlayPauseButton_Click"
                            Width="72"
                            IsEnabled="False" />
                    <TextBlock Grid.Column="1"
                               Text="이동"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0" />
                    <ComboBox Grid.Column="2"
                              x:Name="SeekStepComboBox"
                              Width="78"
                              SelectedIndex="2"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              IsEnabled="False">
                        <ComboBoxItem Content="1초" Tag="1" />
                        <ComboBoxItem Content="3초" Tag="3" />
                        <ComboBoxItem Content="5초" Tag="5" />
                        <ComboBoxItem Content="10초" Tag="10" />
                        <ComboBoxItem Content="30초" Tag="30" />
                    </ComboBox>
                    <TextBlock Grid.Column="3"
                               Text="음량"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0" />
                    <Slider Grid.Column="4"
                            x:Name="VolumeSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="100"
                            Width="100"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            IsEnabled="False" />
                    <TextBlock Grid.Column="5"
                               x:Name="VolumeValueText"
                               Text="100%"
                               Width="38"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Margin="6,0,0,0" />
                    <TextBlock Grid.Column="6"
                               x:Name="CurrentTimeText"
                               Text="00:00:00.000"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0" />
                    <Slider Grid.Column="7"
                            x:Name="TimelineSlider"
                            Minimum="0"
                            Maximum="1"
                            ValueChanged="TimelineSlider_ValueChanged"
                            PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                            PreviewMouseUp="TimelineSlider_PreviewMouseUp"
                            IsEnabled="False"
                            VerticalAlignment="Center"
                            Margin="12,0" />
                    <TextBlock Grid.Column="8"
                               x:Name="DurationText"
                               Text="00:00:00.000"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                x:Name="AudioTrackHost"
                Margin="0,10,354,0"
                Padding="12"
                Background="#FFFFFF"
                BorderBrush="#D9DEE7"
                BorderThickness="1"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="오디오 트랙"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="AudioTrackHelpText"
                               DockPanel.Dock="Right"
                               Text="미리듣기에만 적용"
                               Foreground="#6B7280"
                               VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer Grid.Row="1"
                              Margin="0,8,0,0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="AudioTracksPanel"
                                Orientation="Horizontal" />
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   Text="준비됨"
                   Foreground="#4B5563"
                   Margin="0,8,0,0" />
    </Grid>
</Window>
